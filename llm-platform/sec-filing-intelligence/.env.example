# Model access. Unset everything and the platform runs in replay mode (recorded fixtures).
FILING_INTEL_PROVIDER=anthropic          # anthropic | bedrock | replay
ANTHROPIC_API_KEY=
FILING_INTEL_MODEL=claude-opus-5
FILING_INTEL_EFFORT=high                 # low | medium | high | xhigh | max

# Bedrock (only when FILING_INTEL_PROVIDER=bedrock)
AWS_REGION=us-east-1

# Redis. Omit to fall back to an in-process cache with identical semantics.
FILING_INTEL_REDIS_URL=redis://localhost:6379/0

# SEC EDGAR requires a descriptive User-Agent with contact info, or it returns 403.
FILING_INTEL_SEC_USER_AGENT=filing-intel/0.1 (you@example.com)
